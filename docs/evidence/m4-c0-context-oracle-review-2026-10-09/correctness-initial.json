      "id": "COR-CTX-002",
      "impact": "A non-decreasing/quantized monotonic clock can give the pre-marker sample and a later complete receipt the same value. The implementation promotes that ambiguous boundary to positive ACK evidence. This is a synthetic classification bug, not a claim of Redis/D02 or M4 acceptance.",
      "minimal_correction": "Require complete_ns < lower (not <=) for timestamp-only ACK credit; retain unknown on equality. Add lower-bound and zero-width-interval tie regressions, and preserve the separately gated calibrated uncertainty requirements.",
      "priority": "blocker",
      "reproduction": {
        "expected": "classification_at_cut=unknown when completion_ns equals lower_ns without additional causal proof.",
        "function": "real_socket_boundaries",
        "method": "Send 1024 C bytes over a benign socketpair, consume them through production FrameClient with completion clock value 100, then call ClientTranscript.cut(100, 200).",
        "result": {
          "completion_ns": 100,
          "lower_ns": 100,
          "summary": {
            "bytes": 1024,
            "classification_at_cut": "acknowledged",
            "closed": false,
            "complete_after_cut": false,
            "complete_ns": 100,
            "cut_proved": true,
            "eof": false,
            "transport_error": false
          },
          "upper_ns": 200
        },
        "retained_execution": "independent_probes_v2.py",
        "script": "independent_probes.py"
      },
      "severity": "medium",
      "status": "proven_source_counterexample",
      "title": "A receipt tied with the lower cut timestamp is incorrectly credited as acknowledged"
    }
