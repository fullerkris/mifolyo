    {
      "evidence": [
        {
          "detail": "complete_ns <= lower upgrades an equal timestamp to acknowledged.",
          "file": "tests/crawl-jobs-v2-observer/oracle_protocol.py",
          "lines": [
            122,
            135
          ]
        },
        {
          "detail": "The cut interval is built from a target pre-marker timestamp and a later causal oracle sample; equality is not a separate client-before-marker handshake.",
          "file": "tests/crawl-jobs-v2-observer/oracle_worker.py",
          "lines": [
            117,
