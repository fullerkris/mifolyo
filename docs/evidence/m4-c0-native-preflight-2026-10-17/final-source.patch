+                self.assertNotIn(b"PRIVATE_CANARY", canonical(result))
+
+    def test_missing_collector_does_not_issue_an_anchor(self):
+        for state in ("MISSING", "UNEXPECTED_TYPE"):
+            probe = FixtureProbe()
