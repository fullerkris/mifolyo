+    struct.pack_into("<16sHHIQQQIHHHHHH", raw, 0, b"\x7fELF\x02\x01\x01" + bytes(9), 3,
+        62 if architecture == "x86_64" else 183, 1, 0x100, 64, 0, 0, 64, 56, count, 0, 0, 0)
