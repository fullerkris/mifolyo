+ROOT_METADATA_SCRIPT = '''import json,os,stat,subprocess,sys
+command=[sys.argv[1],"--remote=false"]
+try:
+    path=subprocess.check_output(command+["mount",sys.argv[2]],text=True,timeout=30).strip()
