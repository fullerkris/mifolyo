+        struct.pack_into("<IIQQQQQQ", raw, cursor, 2, 4, 0x300, 0x300, 0, len(tags) * 16, len(tags) * 16, 8)
+        for index, (tag, value) in enumerate(tags): struct.pack_into("<QQ", raw, 0x300 + 16 * index, tag, value)
+    return bytes(raw)
