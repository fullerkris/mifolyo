# Copy to .env.production (ignored by Git) and protect with chmod 600.
# Use unique release tags or repository@sha256:... references for both apps.
MIFOLYO_QUERY_IMAGE=ghcr.io/fullerkris/mifolyo/query-engine:REPLACE_WITH_RELEASE
MIFOLYO_FORUM_IMAGE=ghcr.io/fullerkris/mifolyo/forum-engine:REPLACE_WITH_RELEASE
MIFOLYO_PUBLIC_URL=https://srv1459482.tail11b93a.ts.net
MIFOLYO_HTTP_PORT=18090

# Generate each key once: printf 'base64:'; openssl rand -base64 32
# Keep these stable across deployments.
QUERY_APP_KEY=
FORUM_APP_KEY=
# Generate each password independently: openssl rand -hex 32
MONGO_ROOT_PASSWORD=
MONGO_QUERY_PASSWORD=
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# Production email delivery (smtp = STARTTLS when supported; smtps = implicit TLS).
MAIL_SCHEME=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
