FROM php:8.4-fpm-bookworm AS runtime

RUN apt-get update \
    && apt-get install -y --no-install-recommends libpq-dev libonig-dev unzip \
    && docker-php-ext-install pdo_pgsql mbstring pcntl \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /var/www

FROM runtime AS dependencies
COPY --from=composer:2.8 /usr/bin/composer /usr/bin/composer
COPY composer.json composer.lock ./
RUN composer install --no-dev --no-interaction --prefer-dist --optimize-autoloader --no-scripts

FROM node:22-bookworm-slim AS assets
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY postcss.config.js tailwind.config.js vite.config.js ./
COPY resources ./resources
RUN npm run build

FROM runtime
COPY --chown=www-data:www-data . ./
COPY --from=dependencies --chown=www-data:www-data /var/www/vendor ./vendor
COPY --from=assets --chown=www-data:www-data /app/public/build ./public/build
RUN mkdir -p storage/framework/views storage/framework/cache/data storage/framework/sessions bootstrap/cache /assets \
    && chown -R www-data:www-data storage bootstrap/cache /assets
USER www-data
RUN php artisan package:discover --ansi
CMD ["php-fpm"]
