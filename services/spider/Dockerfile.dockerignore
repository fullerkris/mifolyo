# Spider builds use the repository root, but only these inputs may enter.
**
!services/spider/**
!contracts/crawl-jobs-v2/digest-vectors.json
!contracts/url-canonicalization/v1.json
!docs/crawl-jobs-v2.md
!seeds/manual-seeds.csv
!scripts/verify-crawl-jobs-v2-digests.py
!scripts/crawl_jobs_v2_url.py
!scripts/generate-crawl-jobs-v2-lua.py
!scripts/generate-crawl-jobs-v2-bundle.py
!scripts/tests/test_crawl_jobs_v2_url.py
!tests/crawl-jobs-v2-redis/harness.py
!tests/crawl-jobs-v2-redis/test_harness.py
!tests/crawl-jobs-v2-redis/redis.conf
!tests/crawl-jobs-v2-redis/runtime_case.py
!tests/crawl-jobs-v2-redis/resp.py
!tests/crawl-jobs-v2-redis/claim_release.py
!tests/crawl-jobs-v2-redis/test_claim_release.py
!tests/crawl-jobs-v2-redis/negative_specs.py
!tests/crawl-jobs-v2-redis/negative_cases.py
!tests/crawl-jobs-v2-redis/test_negative_cases.py

**/*.env
**/.env*
**/*.key
**/*.pem
**/*.crt
**/*.cer
**/*.p12
**/*.pfx
**/.git
**/.git/**
services/spider/spider
services/spider/spider.exe
services/spider/*.test
