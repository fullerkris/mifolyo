# Python 3.13.15/slim-bookworm platform children of the previously pinned index.
ARG C0_ARCHITECTURE=aarch64
FROM docker.io/library/python@sha256:ad4c34ff79289506e235b40dce75d629e25f226b597a2455804220f037e07531 AS python-aarch64
FROM docker.io/library/python@sha256:3e2de9c40ca4e3d73240059f9d48baff27908f10293e985a2f382a0378e6df4a AS python-x86_64
FROM python-${C0_ARCHITECTURE} AS oracle
WORKDIR /
COPY contracts.py runtime_admission.py linux_observation.py oracle.py oracle_protocol.py oracle_worker.py worker.py build_oracle.py /oracle/
USER 999:999
ENTRYPOINT ["python3"]
CMD ["-I", "-B", "/oracle/worker.py"]

# Artifact generation executes only the manifest builder, never the worker.
FROM oracle AS oracle-build
ARG C0_ARCHITECTURE
USER 0:0
RUN python3 -I -B /oracle/build_oracle.py /artifacts "$C0_ARCHITECTURE"

FROM scratch AS artifacts
COPY --from=oracle-build /artifacts/ /
